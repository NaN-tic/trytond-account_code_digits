#, python-format
msgctxt "model:ir.message,text:invalid_code_digits"
msgid ""
"The number of code digits %(account_digits)d of account \"%(account)s\" must "
"be %(digits)d."
msgstr ""
"កូដគណនី «%(account)s» មាន %(account_digits)d ខ្ទង់ ប៉ុន្តែត្រូវមាន %(digits)d"
" ខ្ទង់។"

